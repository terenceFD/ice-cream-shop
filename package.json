{
  "name": "ice-cream-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "test:migration": "node --test scripts/sqlite-postgres-schema.test.js server/postgres.test.js",
    "preview": "vite preview",
    "seed:admin": "node server/seedAdmin.js",
    "migrate:supabase": "node scripts/migrate-sqlite-to-supabase.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
