PORT=3001
DATABASE_BACKEND=sqlite
JWT_SECRET=
# Optional stable MFA encryption key. For existing MFA accounts, use the ORIGINAL
# JWT_SECRET from the server where MFA was enrolled before rotating JWT_SECRET.
# All servers sharing the admins database must use the same MFA encryption key.
ADMIN_MFA_ENCRYPTION_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# The one public address used in the sitemap, canonical links and link previews.
# Set this to the shop's own domain when it moves off the Render hostname.
# Leave it empty until then. A value that is not an http(s) address is ignored.
# SITE_URL=https://ice-cream-shop-20eg.onrender.com
# Optional; defaults to server/database.sqlite
# DATABASE_PATH=C:\path\to\database.sqlite
# Optional PostgreSQL backend. Set DATABASE_BACKEND=postgres only after schema/data migration and staging tests.
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL_CA_FILE=C:\path\to\supabase-ca.crt
# DATABASE_SSL=disable

# Required only for the one-time first-admin command:
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Menu image uploads. Required on the live site, because Render wipes the server disk on every deploy.
# Use the Project URL and the service_role key from Supabase > Project Settings > API. Keep the key secret.
# The public bucket is created automatically on the first upload. Leave empty locally to save to server/uploads.
# The shop's WhatsApp number for the chat button, in international format (e.g. 237690000000).
# Leave empty to hide the button.
WHATSAPP_NUMBER=
# Optional WhatsApp Cloud API so customers receive order updates on WhatsApp.
# From Meta > WhatsApp > API Setup. Leave empty to keep email and in-app alerts only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional WhatsApp Cloud API so customers receive order updates on WhatsApp.
# From Meta > WhatsApp > API Setup. Leave empty to keep email and in-app alerts only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images

# Email delivery. Brevo is used whenever BREVO_API_KEY is set: it sends over HTTPS on
# port 443, which works on hosts that block outgoing SMTP ports (Render's free plan does).
# Get the key from app.brevo.com > SMTP & API > API Keys.
# MAIL_FROM must be an address on a domain verified under app.brevo.com > Senders, Domains
# & Dedicated IPs. A Gmail address cannot be used as the sender.
BREVO_API_KEY=
MAIL_FROM=

# Optional SMTP fallback, used only when BREVO_API_KEY is empty. Leave SMTP_HOST empty on
# Render's free plan, which blocks every outgoing SMTP port.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Payment receipts are always emailed now that a customer has been charged; there is no
# switch. This line is kept only so an older .env still loads without a warning.
PAYMENT_CONFIRMATION_EMAILS_ENABLED=true

# Stripe Checkout. Use test-mode keys during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CamPay hosted checkout for Cameroon Mobile Money.
# Keep disabled until CamPay credentials and the intended MTN/Orange collection rails are verified.
CAMPAY_ENVIRONMENT=DEV
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_MOBILE_MONEY_ENABLED=false

# Promotion alerts sent to signed-in customers' devices (Web Push).
# Generate a pair once with: npx web-push generate-vapid-keys
# Keep the private key secret. Changing the keys signs everyone out of alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can use about this site.
VAPID_SUBJECT=mailto:you@example.com

# Optional AI assistant for the admin live chat. Any OpenAI-compatible provider works.
# Primary provider (e.g. Cerebras — 1M tokens/day free, https://cloud.cerebras.ai):
# AI_BASE_URL=https://api.cerebras.ai/v1
# AI_MODEL=gpt-oss-120b
# AI_API_KEY=csk-...
# Optional vision model on the same provider, used when a customer attaches a photo
# (Cerebras vision: qwen-3.8-27b; leave empty and photos travel as text only):
# AI_VISION_MODEL=qwen-3.8-27b
#
# Optional failover provider, used when the primary is rate-limited or down.
# Leave empty to run on the primary alone. Example with Groq as backup:
# AI_FAILOVER_BASE_URL=https://api.groq.com/openai/v1
# AI_FAILOVER_MODEL=llama-3.1-8b-instant
# AI_FAILOVER_API_KEY=gsk_...
#
# Leave AI_API_KEY empty to use the built-in rule-based drafter, which answers from the
# shop's own menu, branches, hours and discount codes without any external service.

# Automatic AI replies in the customer live chat. When true, every customer message
# gets an instant AI answer sent to the thread without staff approval. Requires both
# AI_API_KEY and AI_MODEL to be set; without a model the flag does nothing and staff
# answer by hand as before. Staff replies always win: if a human has already answered
# the customer's latest message, the AI stays quiet.
CHAT_AUTO_REPLY=false
