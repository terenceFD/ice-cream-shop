PORT=3001
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# Optional; defaults to server/database.sqlite
# DATABASE_PATH=C:\path\to\database.sqlite
# Optional PostgreSQL backend. Only enable after schema/data migration and staging tests.
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL_CA_FILE=C:\path\to\supabase-ca.crt
# DATABASE_SSL=disable

# Required only for the one-time first-admin command:
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Menu image uploads. Required on the live site, because Render wipes the server disk on every deploy.
# Use the Project URL and the service_role key from Supabase > Project Settings > API. Keep the key secret.
# The public bucket is created automatically on the first upload. Leave empty locally to save to server/uploads.
# The shop's WhatsApp number for the chat button, in international format (e.g. 237690000000).
# Leave empty to hide the button.
WHATSAPP_NUMBER=
# Optional WhatsApp Cloud API so customers receive order updates on WhatsApp.
# From Meta > WhatsApp > API Setup. Leave empty to keep email and in-app alerts only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional WhatsApp Cloud API so customers receive order updates on WhatsApp.
# From Meta > WhatsApp > API Setup. Leave empty to keep email and in-app alerts only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images

# Mailjet. Render's free plan blocks ports 25, 465 and 587, so use 2525.
# SMTP_USER is the API key and SMTP_PASSWORD is the secret key (Account settings > SMTP and SEND API settings).
# SMTP_FROM must be a validated sender address.
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set true to send payment confirmation emails after Stripe confirms an order.
PAYMENT_CONFIRMATION_EMAILS_ENABLED=false

# Stripe Checkout. Use test-mode keys during development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CamPay hosted checkout for Cameroon Mobile Money.
# Keep disabled until CamPay credentials and the intended MTN/Orange collection rails are verified.
CAMPAY_ENVIRONMENT=DEV
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_MOBILE_MONEY_ENABLED=false

# Promotion alerts sent to signed-in customers' devices (Web Push).
# Generate a pair once with: npx web-push generate-vapid-keys
# Keep the private key secret. Changing the keys signs everyone out of alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can use about this site.
VAPID_SUBJECT=mailto:you@example.com
